# Frontend Environment Configuration
# Copy this file to .env and update values for your deployment

# Backend API URL - Set this to connect to a remote backend
# For local development: http://localhost:8000
# For remote access: http://YOUR_PUBLIC_IP:8000
# For reverse proxy: https://your-domain.com
VITE_API_BASE_URL=http://localhost:8000

# WebSocket URL (optional - defaults to API_BASE_URL with ws:// protocol)
# VITE_WS_URL=ws://localhost:8000/ws
