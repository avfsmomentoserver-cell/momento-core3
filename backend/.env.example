# Backend Environment Configuration
# Copy this file to .env and update values for your deployment

# API Server Configuration
MOMENTO_API_HOST=0.0.0.0
MOMENTO_API_PORT=8000

# Security
MOMENTO_SECRET_KEY=change-this-to-a-secure-random-key-in-production
MOMENTO_TOKEN_TTL=43200

# Operator Bootstrap Account
MOMENTO_OPERATOR_EMAIL=operator@momento.local
MOMENTO_OPERATOR_PASSWORD=change-this-password

# CORS Configuration
# Add your frontend URLs here for remote access
# Example: MOMENTO_CORS_ORIGINS=http://localhost:5173,http://YOUR_PUBLIC_IP:5173,https://your-domain.com
MOMENTO_CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# Set to false in production for stricter CORS
MOMENTO_CORS_ALLOW_ALL=true

# Data Directories (optional - uses defaults if not set)
# MOMENTO_DATA_DIR=/path/to/data
# MOMENTO_INBOX_DIR=/path/to/inbox
# MOMENTO_PROCESSED_DIR=/path/to/processed
# MOMENTO_FAILED_DIR=/path/to/failed
# MOMENTO_DOWNLOADS_DIR=/path/to/downloads
# MOMENTO_LOG_DIR=/path/to/logs

# Watcher Configuration
MOMENTO_WATCHER_ENABLED=true
MOMENTO_WATCHER_INTERVAL=2.0
MOMENTO_WATCH_DOWNLOADS=false

# Feed Configuration
MOMENTO_FEED_AUTOSTART=true
